{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jswarm.fix-defect-backlog.v1.schema.json",
  "title": "Canonical fix defect backlog",
  "type": "object",
  "required": ["schema", "ticket", "revision", "rows", "receipts"],
  "properties": {
    "schema": {"const": "jswarm.fix-defect-backlog/v1"},
    "ticket": {"type": "string"},
    "revision": {"type": "integer", "minimum": 0},
    "rows": {"type": "object"},
    "receipts": {"type": "array"}
  },
  "$defs": {
    "stage": {"enum": ["observation", "conviction", "assignment", "repair", "proof", "disposition"]},
    "fieldOwners": {
      "observation": "test",
      "scenario_provenance": "test",
      "conviction": "fix",
      "defect_class": "fix",
      "catch_stage": "fix",
      "cycle": "fix",
      "repair": "fix",
      "proof": "fix",
      "disposition": "fix",
      "authority_sha256": "fix",
      "closure_validation": "jclose"
    }
  },
  "additionalProperties": false
}
