{"$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "jswarm.fix-contracts/v2", "title": "Fix-cycle governance contracts", "$defs": {"riskClass": {"enum": ["local_logic", "composed_runtime", "sandbox", "command", "wire", "persistence", "identity", "vocabulary", "pipeline", "uat_escape"]}, "overlay": {"type": "object", "additionalProperties": false, "required": ["schema", "project"], "properties": {"schema": {"const": "jswarm.fix-overlay/v1"}, "project": {"type": "string"}, "defaults": {"type": "object"}, "risk_rules": {"type": "array"}, "proof_profiles": {"type": "object"}, "proof_gates": {"type": "object"}}}, "ticketPolicyV2": {"type": "object", "additionalProperties": false, "required": ["schema", "ticket", "revision", "status", "mode", "selected_risk_classes", "selected_proof_profiles", "closure_mode", "global_floor_assertion", "scenario_refs", "nfr_refs", "backlog_ref"], "properties": {"schema": {"const": "jswarm.fix-policy/v2"}, "ticket": {"type": "string"}, "revision": {"type": "integer", "minimum": 1}, "status": {"enum": ["active", "superseded"]}, "mode": {"enum": ["quick", "standard"]}, "selected_risk_classes": {"type": "array", "items": {"$ref": "#/$defs/riskClass"}}, "selected_proof_profiles": {"type": "array", "items": {"type": "string"}}, "closure_mode": {"enum": ["not_required", "test_uat", "owner_manual", "both"]}, "global_floor_assertion": {"const": true}, "scenario_refs": {"type": "array", "items": {"type": "string"}}, "nfr_refs": {"type": "array", "items": {"type": "string"}}, "backlog_ref": {"type": "string"}, "envelope_ref": {"type": "object"}, "cycle_refs": {"type": "array", "items": {"type": "string"}}}}, "quickEnvelope": {"type": "object", "additionalProperties": false, "required": ["schema", "ticket", "status", "expires", "body", "effective_sha256"], "properties": {"schema": {"const": "jswarm.fix-envelope/v1"}, "ticket": {"type": "string"}, "envelope_id": {"type": "string"}, "status": {"enum": ["active", "superseded"]}, "issued_by": {"const": "jArchitect"}, "expires": {"type": "string"}, "body": {"type": "object"}, "effective_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}, "alignmentReceipt": {"type": "object", "additionalProperties": false, "required": ["schema", "ticket", "cycle_ref", "kind", "scenario_refs", "nfr_refs"], "properties": {"schema": {"const": "jswarm.fix-alignment-receipt/v1"}, "ticket": {"type": "string"}, "cycle_ref": {"type": "string"}, "kind": {"enum": ["delta", "no_delta"]}, "scenario_refs": {"type": "array", "items": {"type": "string"}}, "nfr_refs": {"type": "array", "items": {"type": "string"}}, "delta": {"type": "array"}, "reason": {"type": "string"}}}, "closureReceipt": {"type": "object", "additionalProperties": false, "required": ["schema", "ticket", "kind", "ref"], "properties": {"schema": {"const": "jswarm.fix-closure-receipt/v1"}, "ticket": {"type": "string"}, "kind": {"enum": ["wrapper_canary", "alignment", "test_uat_round", "owner_manual_acceptance", "final_proof", "blocked_disposition"]}, "ref": {"type": "string"}}}, "quickReceipt": {"type": "object", "additionalProperties": false, "required": ["schema", "ticket", "envelope_ref", "class", "touched_paths", "changed_files", "changed_lines"], "properties": {"schema": {"const": "jswarm.fix-quick-receipt/v1"}, "ticket": {"type": "string"}, "envelope_ref": {"type": "object"}, "class": {"type": "string"}, "touched_paths": {"type": "array", "items": {"type": "string"}}, "changed_files": {"type": "integer"}, "changed_lines": {"type": "integer"}}}}}
