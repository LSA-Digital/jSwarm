{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jswarm.fix-contracts/v1",
  "title": "Sealed /fix localization contracts",
  "$defs": {
    "runner": {"type": "object", "additionalProperties": false, "required": ["kind", "target"], "properties": {"kind": {"enum": ["pytest", "script", "playwright_manifest", "http_canary"]}, "target": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+"}, "selector": {"type": "string"}}},
    "proofGate": {"type": "object", "additionalProperties": false, "required": ["kind", "phase", "runner", "evidence_shape"], "properties": {"kind": {"enum": ["unit", "assembly", "connected_parity", "capture_replay", "contract", "canary", "uat"]}, "phase": {"enum": ["pre_implementation", "red", "pre_review", "post_deploy_pre_uat", "final_verification", "acceptance"]}, "runner": {"type": "object", "additionalProperties": false, "required": ["kind", "target"], "properties": {"kind": {"enum": ["pytest", "script", "playwright_manifest", "http_canary"]}, "target": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+"}, "selector": {"type": "string"}}}, "evidence_shape": {"enum": ["junit", "json", "structured_log", "http_assertion"]}}},
    "proofProfile": {"type": "object", "additionalProperties": false, "required": ["outcome", "risk_classes", "seam", "expected_value_authority", "fixture_refs", "gate_refs", "counterexample_mode", "timeout_seconds"], "properties": {"outcome": {"type": "string"}, "risk_classes": {"type": "array", "items": {"$ref": "#/$defs/riskClass"}}, "seam": {"type": "string"}, "expected_value_authority": {"type": "string"}, "fixture_refs": {"type": "array", "items": {"type": "string"}}, "gate_refs": {"type": "array", "items": {"type": "string"}}, "counterexample_mode": {"enum": ["revert", "fault_seed", "fixture_variant"]}, "canary_ref": {"type": ["string", "null"]}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600}}},
    "riskClass": {"enum": ["local_logic", "composed_runtime", "sandbox", "command", "wire", "persistence", "identity", "vocabulary", "pipeline", "uat_escape"]},
    "overlay": {"type": "object", "additionalProperties": false, "required": ["schema", "project"], "properties": {"schema": {"const": "jswarm.fix-overlay/v1"}, "project": {"type": "string"}, "defaults": {"type": "object"}, "risk_rules": {"type": "array"}, "proof_profiles": {"type": "object", "additionalProperties": {"$ref": "#/$defs/proofProfile"}}, "proof_gates": {"type": "object", "additionalProperties": {"$ref": "#/$defs/proofGate"}}}},
    "ticketPolicy": {"type": "object", "additionalProperties": false, "required": ["schema", "ticket", "revision", "status", "selected_risk_classes", "selected_proof_profiles", "closure_mode", "global_floor_assertion"], "properties": {"schema": {"const": "jswarm.fix-policy/v1"}, "ticket": {"type": "string"}, "revision": {"type": "integer", "minimum": 1}, "status": {"enum": ["active", "superseded"]}, "selected_risk_classes": {"type": "array", "items": {"$ref": "#/$defs/riskClass"}}, "selected_proof_profiles": {"type": "array", "items": {"type": "string"}}, "closure_mode": {"enum": ["not_required", "test_uat", "owner_manual", "both"]}, "global_floor_assertion": {"const": true}}},
    "boundaryRow": {"type": "object", "additionalProperties": false, "required": ["boundary_id", "risk_class", "producer_ref", "consumer_ref", "expected_value_authority", "fixture_refs", "proving_gate_ref", "status"], "properties": {"boundary_id": {"type": "string"}, "risk_class": {"$ref": "#/$defs/riskClass"}, "producer_ref": {"type": "string"}, "consumer_ref": {"type": "string"}, "expected_value_authority": {"type": "string", "pattern": ".+"}, "fixture_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+"}}, "proving_gate_ref": {"type": "string"}, "status": {"enum": ["required", "crossed", "blocked", "not_applicable"]}}},
    "cycleContract": {"type": "object", "additionalProperties": false, "required": ["schema", "ticket", "cycle_id", "state", "provenance", "effective", "effective_sha256", "proofs", "closure_mode", "final_verification"], "properties": {"schema": {"const": "jswarm.fix-cycle/v1"}, "ticket": {"type": "string"}, "cycle_id": {"type": "string"}, "state": {"enum": ["draft", "frozen", "implementing", "proof_pending", "verified", "review_pending", "acceptance_pending", "closed", "blocked"]}, "provenance": {"type": "array", "minItems": 5}, "effective": {"type": "object"}, "effective_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "boundary_map": {"type": "array", "items": {"$ref": "#/$defs/boundaryRow"}}, "proofs": {"type": "array"}, "closure_mode": {"enum": ["not_required", "test_uat", "owner_manual", "both"]}, "test_uat_refs": {"type": "array", "items": {"type": "string"}}, "final_verification": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["pending", "passed", "failed"]}}}}},
    "evidenceResult": {"type": "object", "additionalProperties": false, "required": ["gate_ref", "status", "evidence_ref"], "properties": {"gate_ref": {"type": "string"}, "status": {"enum": ["required", "pending", "passed", "failed", "blocked", "not_applicable"]}, "evidence_ref": {"type": "string"}}}
  }
}
