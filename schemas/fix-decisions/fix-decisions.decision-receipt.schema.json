{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jswarm.example/schemas/fix-decisions/decision-receipt/v1.1",
  "title": "Fix-Decision Receipt",
  "description": "Immutable decision receipt bound to the exact contract path and digest visible at submit time. v1.1 (owner expansion 2026-08-27): receipts are DECISIONS ONLY (approve/deny/comment); question/answer moved to the separate qa-thread schema, cross-linked by the optional thread_id field. Approve/deny may carry an optional comment; a standalone comment receipt requires comment. Human approvals capture the required vocabulary; settings-authorized receipts record the settings path/digest and authorization_source auto. Unknown fields fail closed except the x_extension namespace.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "receipt_id",
    "publication_id",
    "action",
    "actor",
    "created_at_utc",
    "contract_path",
    "contract_sha256",
    "contract_schema",
    "contract_version",
    "gate_kind"
  ],
  "properties": {
    "schema": { "const": "jswarm.fix-decisions.decision-receipt/v1" },
    "schema_version": { "enum": ["1.0", "1.1"] },
    "receipt_id": { "type": "string", "minLength": 1 },
    "publication_id": { "type": "string", "minLength": 1 },
    "action": { "enum": ["approve", "deny", "comment"] },
    "actor": { "type": "string", "minLength": 1 },
    "created_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "contract_path": { "type": "string", "minLength": 1 },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contract_schema": { "type": "string", "minLength": 1 },
    "contract_version": { "type": "string", "minLength": 1 },
    "gate_kind": {
      "enum": ["defect-contract-scope", "fix-contract-digest"]
    },
    "comment": { "type": "string" },
    "required_approval_vocabulary": {
      "type": "string",
      "minLength": 1,
      "description": "Human approvals capture the exact approval phrase text submitted."
    },
    "thread_id": {
      "type": "string",
      "minLength": 1,
      "description": "Optional cross-link to the qa-thread this decision receipt relates to."
    },
    "authorization_source": { "const": "auto" },
    "fix_settings_path": { "type": "string", "minLength": 1 },
    "fix_settings_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "x_extension": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "approve" } }, "required": ["action"] },
      "then": { "required": ["required_approval_vocabulary"] }
    },
    {
      "if": { "properties": { "action": { "const": "comment" } }, "required": ["action"] },
      "then": { "required": ["comment"] }
    },
    {
      "if": {
        "required": ["authorization_source"],
        "properties": { "authorization_source": { "const": "auto" } }
      },
      "then": { "required": ["fix_settings_path", "fix_settings_sha256"] }
    }
  ]
}
