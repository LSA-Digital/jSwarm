{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jswarm.example/schemas/fix-decisions/publication-manifest/v1.0",
  "title": "Fix-Decision Publication Manifest",
  "description": "Records the publication of a contract: the digest is computed over the exact JSON bytes of the contract at publication time, avoiding the self-digest paradox. Also binds the ticket-local receipt directory, allowed repository root, and fix-settings authority for auto gates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "publication_id",
    "contract_path",
    "contract_sha256",
    "contract_schema",
    "contract_version",
    "published_at_utc",
    "gate_kind",
    "receipt_directory",
    "allowed_repo_root",
    "fix_settings_path",
    "fix_settings_sha256"
  ],
  "allOf": [
    {
      "if": {
        "properties": { "schema_version": { "const": "1.1" } },
        "required": ["schema_version"]
      },
      "then": {
        "required": [
          "publication_kind",
          "publication_fingerprint",
          "source_repo_root",
          "source_input_kind",
          "source_input_path",
          "source_fix_settings_path"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": { "const": "1.1" },
          "contract_schema": { "const": "jswarm.fix-decisions.fix-contract/v1" }
        },
        "required": ["schema_version", "contract_schema"]
      },
      "then": {
        "required": [
          "source_parent_defect_contract_path",
          "parent_defect_contract_path"
        ]
      }
    }
  ],
  "properties": {
    "schema": { "const": "jswarm.fix-decisions.publication-manifest/v1" },
    "schema_version": { "enum": ["1.0", "1.1"] },
    "publication_id": { "type": "string", "minLength": 1 },
    "contract_path": { "type": "string", "minLength": 1 },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contract_schema": { "type": "string", "minLength": 1 },
    "contract_version": { "type": "string", "minLength": 1 },
    "published_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "publication_kind": {
      "enum": ["gate", "informational"],
      "default": "gate",
      "description": "gate = requires an owner decision receipt; informational = auto-included within-scope revision (first_repair_authorizing:false), never a third gate."
    },
    "gate_kind": {
      "enum": ["defect-contract-scope", "fix-contract-digest"]
    },
    "receipt_directory": {
      "type": "string",
      "pattern": "^\\.jswarm/(plans|decision-review)/"
    },
    "allowed_repo_root": { "type": "string", "minLength": 1 },
    "fix_settings_path": { "type": "string", "minLength": 1 },
    "fix_settings_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "publication_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_repo_root": { "type": "string", "minLength": 1 },
    "source_input_kind": { "enum": ["json", "markdown"] },
    "source_input_path": { "type": "string", "minLength": 1 },
    "source_fix_settings_path": { "type": "string", "minLength": 1 },
    "source_parent_defect_contract_path": { "type": "string", "minLength": 1 },
    "parent_defect_contract_path": { "type": "string", "minLength": 1 }
  }
}
